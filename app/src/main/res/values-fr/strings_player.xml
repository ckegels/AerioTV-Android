    <!-- ArrTvOptimizations.kt -->
    <string name="player_arrtv_opt_identify_device_title">Indiquer à Dispatch More de quelle TV il s\'agit</string>
    <string name="player_arrtv_opt_identify_device_subtitle">Identifiant et nom de l\'appareil, chaîne quittée, session Multivue. Désactivé : rien de ce qui en dépend ci-dessous ne fonctionne.</string>
    <string name="player_arrtv_opt_send_max_video_title">Ne lancer que les flux lisibles par cette TV</string>
    <string name="player_arrtv_opt_send_max_video_subtitle">Indique au serveur la plus haute définition que cette TV décode, pour qu\'il ne lui lance jamais un flux 4K qu\'elle ne peut pas lire.</string>
    <string name="player_arrtv_opt_fast_failover_title">Passage plus rapide au flux suivant</string>
    <string name="player_arrtv_opt_fast_failover_subtitle">Attend environ 6 s au lieu de 28 s un flux qui n\'envoie rien, et 6 s au lieu de 15 s un flux illisible.</string>
    <string name="player_arrtv_opt_slow_start_title">Quitter un flux lent à démarrer</string>
    <string name="player_arrtv_opt_slow_start_subtitle">Pas d\'image dans le délai ci-dessous : le flux suivant de la chaîne est essayé. Un flux qui n\'envoie rien du tout est laissé au serveur quand son propre basculement rapide est activé.</string>
    <string name="player_arrtv_opt_adaptive_wait_title">Attendre moins quand une chaîne a plus de flux</string>
    <string name="player_arrtv_opt_adaptive_wait_subtitle">Le délai d\'attente de l\'image suit le nombre d\'autres flux vers lesquels le serveur peut basculer à cet instant (son option « Tell arrTV how many other streams a channel has »). Désactivé : le délai « 1 autre flux » partout.</string>
    <string name="player_arrtv_opt_skip_unplayable_title">Ignorer les flux illisibles par cette TV</string>
    <string name="player_arrtv_opt_skip_unplayable_subtitle">Quand des données arrivent sans image, demande au serveur le flux suivant de la chaîne.</string>
    <string name="player_arrtv_opt_freeze_rescue_title">Rouvrir un flux figé</string>
    <string name="player_arrtv_opt_freeze_rescue_subtitle">Quand l\'image se fige après le démarrage alors que les données continuent d\'arriver, rouvre la chaîne sur une nouvelle connexion.</string>
    <string name="player_arrtv_opt_report_stalls_title">Signaler au serveur les saccades de l\'image</string>
    <string name="player_arrtv_opt_report_stalls_subtitle">Pour que Dispatch More passe aussitôt la chaîne sur un autre flux (son option doit aussi être activée).</string>
