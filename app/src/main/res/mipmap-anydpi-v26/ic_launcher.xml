<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon for API 26+. The system masks the composite to the
    device shape (circle, squircle, ...). The foreground is the "Arr TV" mark:
    a large white "TV" centered on the canvas, a small amber "Arr" above its
    left edge and an amber stand bar below, all inside the 66dp safe zone.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
